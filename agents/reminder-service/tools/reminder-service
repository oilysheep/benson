#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
CORE = ROOT / "libexec/reminder-service-core"
DISCOVERY = ROOT / "lib/reminder_discovery.py"
DISCOVERY_OPERATIONS = {"list-reminders", "find-reminders"}
MUTATION_OPERATIONS = {
    "create-intent",
    "update-reminder",
    "delete-reminder",
    "pause-reminder",
    "resume-reminder",
}


def fail(message: str) -> int:
    print(f"REMINDER_INPUT_INVALID: {message}", file=sys.stderr)
    return 2


def normalize_input_json(args: list[str]) -> tuple[list[str], str | None]:
    indexes = [index for index, value in enumerate(args) if value == "--input-json"]
    if len(indexes) > 1:
        raise ValueError("--input-json may appear only once")
    if not indexes:
        return args, None
    index = indexes[0]
    if index + 1 >= len(args):
        raise ValueError("--input-json requires one compact JSON object")
    if "--input" in args:
        raise ValueError("use either --input-json or --input, not both")
    try:
        value = json.loads(args[index + 1])
    except json.JSONDecodeError as exc:
        raise ValueError(f"invalid JSON: {exc.msg}") from exc
    if not isinstance(value, dict):
        raise ValueError("input JSON must be an object")
    compact = json.dumps(value, ensure_ascii=False, separators=(",", ":"))
    return args[:index] + args[index + 2:] + ["--input", "-"], compact


def main() -> int:
    if not CORE.is_file() or not DISCOVERY.is_file():
        return fail("existing Reminder implementation is incomplete")
    args = list(sys.argv[1:])
    if not args:
        return fail("missing operation")
    operation = args[0]
    if operation in DISCOVERY_OPERATIONS:
        return subprocess.run([sys.executable, str(DISCOVERY), *args], env=dict(os.environ), check=False).returncode
    if operation not in MUTATION_OPERATIONS:
        return fail(f"unsupported operation: {operation}")
    try:
        args, input_text = normalize_input_json(args)
    except ValueError as exc:
        return fail(str(exc))
    completed = subprocess.run(
        [str(CORE), *args],
        input=input_text,
        text=True,
        env=dict(os.environ),
        check=False,
    )
    return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main())
